#BlueJ class context
comment0.target=CircularQueue
comment0.text=\r\n\ CircularQueue\ class\r\n\ \r\n\ This\ class\ implements\ a\ circular\ queue\ using\ an\ array.\r\n\ It\ is\ used\ to\ manage\ REGULAR\ patients\ (first\ come,\ first\ served).\r\n\ \r\n\ FIFO\ principle\:\r\n\ First\ In\ \u2192\ First\ Out\r\n
comment1.params=capacity
comment1.target=CircularQueue(int)
comment1.text=\r\n\ Constructor\r\n\ \r\n\ Initializes\ the\ queue\ with\ a\ fixed\ capacity.\r\n
comment2.params=
comment2.target=boolean\ isEmpty()
comment2.text=\r\n\ Checks\ if\ queue\ is\ empty\r\n
comment3.params=
comment3.target=boolean\ isFull()
comment3.text=\r\n\ Checks\ if\ queue\ is\ full\r\n
comment4.params=
comment4.target=int\ size()
comment4.text=\r\n\ Returns\ number\ of\ patients\ in\ queue\r\n
comment5.params=patient
comment5.target=void\ enqueue(Patient)
comment5.text=\r\n\ Adds\ a\ patient\ to\ the\ queue\ (enqueue\ operation)\r\n\ \r\n\ Steps\:\r\n\ 1.\ Check\ if\ full\r\n\ 2.\ Move\ rear\ forward\ (circularly)\r\n\ 3.\ Insert\ patient\r\n\ 4.\ Increase\ count\r\n
comment6.params=
comment6.target=Patient\ dequeue()
comment6.text=\r\n\ Removes\ a\ patient\ from\ the\ queue\ (dequeue\ operation)\r\n\ \r\n\ Steps\:\r\n\ 1.\ Check\ if\ empty\r\n\ 2.\ Get\ front\ element\r\n\ 3.\ Move\ front\ forward\ (circularly)\r\n\ 4.\ Decrease\ count\r\n
comment7.params=
comment7.target=Patient\ peek()
comment7.text=\r\n\ Returns\ the\ front\ patient\ WITHOUT\ removing\ them\r\n
comment8.params=
comment8.target=void\ displayQueue()
comment8.text=\r\n\ Displays\ all\ patients\ in\ queue\ (in\ correct\ order)\r\n
comment9.params=
comment9.target=Patient[]\ getAllPatients()
comment9.text=\r\n\ Returns\ all\ patients\ as\ an\ array\r\n\ \r\n\ Used\ for\ searching\ or\ processing\r\n
